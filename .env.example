# CampusClear 环境变量样例。复制为 .env 后按现场情况修改。
# 所有键均以 CAMPUSCLEAR_ 开头；未设置的项使用代码内默认值。

# ---------- 服务 ----------
CAMPUSCLEAR_HOST=0.0.0.0
CAMPUSCLEAR_PORT=8000
# 内网自签证书；两者同时配置才启用 HTTPS
CAMPUSCLEAR_TLS_CERT=/etc/campusclear/tls/server.crt
CAMPUSCLEAR_TLS_KEY=/etc/campusclear/tls/server.key

# ---------- 安全（首次启动务必修改） ----------
# 留空则首次启动随机生成并打印到日志，之后固定不再变化（除非删除 data/secret.key）
CAMPUSCLEAR_JWT_SECRET=
CAMPUSCLEAR_JWT_EXPIRE_MINUTES=480
# 首次启动用于创建初始管理员；创建成功后该变量即失效
CAMPUSCLEAR_BOOTSTRAP_ADMIN=admin
CAMPUSCLEAR_BOOTSTRAP_PASSWORD=

# ---------- 目录 ----------
CAMPUSCLEAR_DATA_DIR=./data
CAMPUSCLEAR_MODELS_DIR=./models
CAMPUSCLEAR_LOG_DIR=./data/logs

# ---------- 推理 ----------
# 执行提供器优先级，逗号分隔；离线环境不会去下载任何东西
CAMPUSCLEAR_PROVIDERS=TensorrtExecutionProvider,CUDAExecutionProvider,CPUExecutionProvider
CAMPUSCLEAR_DEVICE_ID=0
CAMPUSCLEAR_USE_FP16=true
# 单张 1080p 输入切分上限（像素），超过则分块推理以控显存
CAMPUSCLEAR_TILE_MAX_PIXELS=921600
CAMPUSCLEAR_TILE_OVERLAP=16

# ---------- 流与调度 ----------
CAMPUSCLEAR_MAX_STREAMS=8
CAMPUSCLEAR_QUEUE_SIZE=8
CAMPUSCLEAR_INFER_FPS=12
CAMPUSCLEAR_OUTPUT_FPS=25
CAMPUSCLEAR_RTSP_OUTPUT_BASE=rtsp://mediamtx:8554
CAMPUSCLEAR_RTSP_OUTPUT_USER=campusclear
CAMPUSCLEAR_RTSP_OUTPUT_PASSWORD=

# ---------- 增强策略 ----------
CAMPUSCLEAR_ENABLE_LOWLIGHT=true
CAMPUSCLEAR_ENABLE_DENOISE=true
CAMPUSCLEAR_ENABLE_DEBLUR=true
CAMPUSCLEAR_ENABLE_SR=true
CAMPUSCLEAR_SR_SCALE=2
# 静止场景跳过推理，复用上一增强结果（关键性能开关）
CAMPUSCLEAR_ENABLE_STATIC_REUSE=true
CAMPUSCLEAR_MOTION_THRESHOLD=0.004
# 噪声闸门：降采样后噪声超过此值即关闭复用。
# 原因：高噪声下背景建模会漏检低对比度运动目标，若仍复用会出现「画面在动却卡住」。
# 调大能省算力，但必须同步验证夜间移动目标无滞后；调小更安全但更费 GPU。
CAMPUSCLEAR_STATIC_REUSE_MAX_NOISE=3.0

# ---------- 负载治理 ----------
CAMPUSCLEAR_GPU_HIGH_WATERMARK=85
CAMPUSCLEAR_GPU_LOW_WATERMARK=60
